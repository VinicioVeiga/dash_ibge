# API de agregados do IBGE. Não exige chave.
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v3
IBGE_TIMEOUT=90

# Redis Community 7.2 (gratuito). Se o servidor não responder, o app usa memória.
REDIS_ENABLED=1
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=43200

# PySpark local: auto usa Spark só se o pacote e o Java estiverem instalados.
# 0 força Polars. 1 tenta Spark e registra a falha se ele não subir.
SPARK_ENABLED=auto

# LLM compatível com a API de chat da OpenAI. Vazio mantém a resposta extrativa do RAG.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Jev (modelo de decisão com saída limitada). Vazio usa o backend local.
# O adaptador espera POST JSON e uma resposta com o campo noul entre 0 e 1.
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=jev
